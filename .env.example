# Template for edge-function secrets — copy real values into
# `supabase secrets set` (hosted) or supabase/.env.local (local serve).
# Never commit real keys.

# Set automatically on hosted Supabase; needed only for local serve.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing (docs/REVENUE.md). sk_test_… for sandbox, sk_live_… at go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_1TyJDiGxbhrlkJVl4YOUgZat
STRIPE_PRICE_QUARTERLY=price_1TyJDsGxbhrlkJVlHDwNtO1Y
CHECKOUT_SUCCESS_URL=https://mangasm.app/plus/success
CHECKOUT_CANCEL_URL=https://mangasm.app/plus
# Optional payment-method configuration (pmc_…) pinned on Checkout sessions.
# Account-scoped: use the live account's pmc with live keys only.
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Shared secret for the owner-only revenue-metrics endpoint; the same value
# is entered once in the /admin/revenue dashboard settings.
ADMIN_DASHBOARD_TOKEN=
