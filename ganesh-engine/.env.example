# ganesh-engine — environment variables
# Copy to .env for local runs; set the same keys in the Vercel project's
# Environment Variables for deployment. Never commit a real .env.

# --- Supabase (service role — full DB access; see migration's security note) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_xxx

# --- App Store Connect ---
# API key from App Store Connect > Users and Access > Integrations > Keys.
APPSTORE_CONNECT_KEY_ID=XXXXXXXXXX
APPSTORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Paste the full .p8 contents; \n line breaks are unescaped automatically.
APPSTORE_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPSTORE_APP_ID=1234567890

# --- Vercel ---
VERCEL_API_TOKEN=xxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxx   # optional — only if the project is under a team

# --- Cron / manual-call auth ---
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET` once
# this var is set in the Vercel project — same secret also authorizes manual
# calls to these endpoints for debugging.
CRON_SECRET=generate-a-long-random-string
